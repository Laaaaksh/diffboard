# Postgres connection string. The bundled docker-compose.yml provisions a
# matching `postgres` service if you don't already have one.
DATABASE_URL="postgresql://diffboard:diffboard@localhost:5432/diffboard"

# Signs session cookies - generate with `openssl rand -hex 32`.
SESSION_SECRET="change-me-to-a-random-32-byte-hex-string"

# Bootstraps the single admin account on first boot (`pnpm seed`). Only takes
# effect if no user with this email exists yet - safe to leave set afterwards.
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="change-me"

# Where screenshot/diff PNGs are written. Point this at a mounted volume in
# production so images survive restarts.
STORAGE_DIR="./data/storage"

# Public URL of this dashboard, used in GitHub commit-status/comment links.
# Defaults to the request's own Host header if unset.
PUBLIC_URL="http://localhost:4300"
