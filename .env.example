# Used by docker-compose.yml when self-hosting with `docker compose up`.
# Copy to .env, fill in real values, then `docker compose up -d`.

# Generate with: openssl rand -hex 32
SESSION_SECRET=

# Bootstraps the one admin account on first boot.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=

# Where your dashboard will be reachable - used in GitHub status/comment links.
PUBLIC_URL=http://localhost:4300
